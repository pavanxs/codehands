{
  "name": "@codehands/local-agent",
  "version": "0.1.0",
  "description": "CodeHands MCP server - HTTP core + stdio adapter",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "codehands": "./dist/cli.js"
  },
  "scripts": {
